# Lingua-AI — шаблон секретов (без значений). Скопируй в .env и заполни.
TG_BOT_TOKEN=        # от @BotFather, @LinguaAI48bot
BOT_LABEL=Lingua-AI
FORUM_GROUP_ID=      # chatId супергруппы флота (-100…)
TOPIC_ID=            # message_thread_id топика Lingua-AI

# ── Supabase (облачное хранилище профиля; Фаза 3 Варианта 3) ──────────────
# Завести проект на supabase.com → Project Settings → API.
# Включить анонимную auth: Authentication → Providers → Anonymous sign-ins → Enable.
# Применить supabase/schema.sql в SQL Editor.
# Пусто = приложение работает на localStorage (оффлайн, без синка).
NEXT_PUBLIC_SUPABASE_URL=       # https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=  # публичный anon-ключ (безопасен для фронта при RLS)
